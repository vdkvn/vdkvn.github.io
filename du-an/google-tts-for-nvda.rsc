f:["$","h2",null,{"id":"intro-heading","children":"1. Giới thiệu tổng quan & Bối cảnh"}]
10:["$","p","0",{"children":"Google TTS for NVDA là một bước tiến vượt bậc trong trải nghiệm tiếp cận kỹ thuật số của người khiếm thị tại Việt Nam, mang chất lượng tổng hợp tiếng nói tự nhiên, êm dịu và chính xác của Google vào trình đọc màn hình NVDA."}]
11:["$","p","1",{"children":"Trong nhiều năm qua, người dùng NVDA tiếng Việt chủ yếu phải sử dụng các bộ đọc máy móc như eSpeak NG (phát âm cứng nhắc, gây mỏi tai khi đọc tài liệu dài) hoặc các giải pháp TTS đám mây đòi hỏi phải có mạng Internet liên tục và thường bị trễ tiếng khi thao tác phím nhanh."}]
12:["$","p","2",{"children":"Được phát triển bởi lập trình viên Nguyễn Anh Đức cùng các cộng tác viên tài năng Đào Đức Trung và Phạm Hùng Vương, add-on này ứng dụng công nghệ WebAssembly (WASM Engine) hiện đại chạy trực tiếp trên nền tảng Chromium ngầm sẵn có trong Windows. Sau khi tải gói giọng đọc một lần duy nhất, toàn bộ quá trình đọc văn bản diễn ra 100% ngoại tuyến (Offline), không gửi bất kỳ dữ liệu nào ra bên ngoài và đảm bảo tốc độ phản hồi tức thì."}]
13:["$","article",null,{"className":"content-block","aria-labelledby":"purpose-heading","children":[["$","div",null,{"className":"block-header","children":[["$","div",null,{"className":"block-icon","aria-hidden":"true","children":["$","$Le",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["circle",{"cx":"12","cy":"12","r":"6","key":"1vlfrh"}],["circle",{"cx":"12","cy":"12","r":"2","key":"1c9p78"}]],"className":"lucide-target","size":24}]}],["$","h2",null,{"id":"purpose-heading","children":"2. Mục đích & Ý nghĩa đối với cộng đồng"}]]}],["$","ul",null,{"className":"purpose-list","children":[["$","li","0",{"children":[["$","$Le",null,{"ref":"$undefined","iconNode":[["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-circle-check","size":20,"aria-hidden":"true"}],["$","span",null,{"children":"Cung cấp giọng đọc tiếng Việt truyền cảm, phát âm tự nhiên, ngắt nghỉ đúng ngữ pháp, giúp học sinh, sinh viên và người đi làm khiếm thị đọc sách, giáo trình và tài liệu mà không bị căng thẳng thính giác."}]]}],["$","li","1",{"children":[["$","$Le",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-circle-check","size":20,"aria-hidden":"true"}],["$","span",null,{"children":"Đảm bảo khả năng làm việc liên tục ở mọi lúc, mọi nơi ngay cả khi không có kết nối Internet hoặc khi đang di chuyển trên tàu xe."}]]}],["$","li","2",{"children":[["$","$Le",null,{"ref":"$undefined","iconNode":"$13:props:children:1:props:children:0:props:children:0:props:iconNode","className":"lucide-circle-check","size":20,"aria-hidden":"true"}],["$","span",null,{"children":"Bảo vệ quyền riêng tư tuyệt đối cho người dùng khi toàn bộ văn bản cá nhân, mật khẩu và nội dung riêng tư được xử lý hoàn toàn cục bộ trên máy tính."}]]}]]}]]}]
14:["$","article",null,{"className":"content-block","aria-labelledby":"features-heading","children":[["$","div",null,{"className":"block-header","children":[["$","div",null,{"className":"block-icon","aria-hidden":"true","children":["$","$Le",null,{"ref":"$undefined","iconNode":[["path",{"d":"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z","key":"1s2grr"}],["path",{"d":"M20 2v4","key":"1rf3ol"}],["path",{"d":"M22 4h-4","key":"gwowj6"}],["circle",{"cx":"4","cy":"20","r":"2","key":"6kqj1y"}]],"className":"lucide-sparkles","size":24}]}],["$","h2",null,{"id":"features-heading","children":"3. Các tính năng nổi bật"}]]}],["$","div",null,{"className":"features-detail-grid","children":[["$","div","0",{"className":"feature-detail-card","children":[["$","h3",null,{"children":"Chất lượng giọng đọc tự nhiên chuẩn Google"}],["$","p",null,{"children":"Sử dụng engine WASM cao cấp nhất của Google, hỗ trợ phát âm tiếng Việt chuẩn xác (cả giọng Bắc và Nam) cùng hơn 40 ngôn ngữ phổ biến trên toàn cầu."}]]}],["$","div","1",{"className":"feature-detail-card","children":[["$","h3",null,{"children":"Hoạt động Ngoại tuyến 100% (Offline)"}],["$","p",null,{"children":"Các gói dữ liệu giọng nói (Voice Packs) được lưu trữ ngay trên ổ cứng máy tính, không tiêu tốn băng thông mạng khi đọc văn bản."}]]}],["$","div","2",{"className":"feature-detail-card","children":[["$","h3",null,{"children":"Trình quản lý giọng đọc (Voice Manager) trực quan"}],["$","p",null,{"children":"Giao diện quản lý tiếp cận thông minh, cho phép người dùng dễ dàng tìm kiếm, tải về, cập nhật hoặc gỡ bỏ các gói ngôn ngữ chỉ với vài phím bấm."}]]}],["$","div","3",{"className":"feature-detail-card","children":[["$","h3",null,{"children":"Tối ưu độ trễ phản hồi siêu thấp (Low Latency)"}],["$","p",null,{"children":"Tích hợp thuật toán phân đoạn từ thông minh (Wordwise Phrase Pronounce) và bộ nhớ đệm phát âm, đảm bảo khi bạn gõ phím hoặc lướt mũi tên là âm thanh phát ra ngay tức thì."}]]}],["$","div","4",{"className":"feature-detail-card","children":[["$","h3",null,{"children":"Hỗ trợ đa ngôn ngữ và chuyển đổi linh hoạt"}],["$","p",null,{"children":"Tự động phát hiện và chuyển đổi giọng đọc phù hợp khi bạn đọc tài liệu song ngữ Anh - Việt hoặc các ngôn ngữ khác."}]]}]]}]]}]
